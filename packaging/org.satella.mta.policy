<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/software/polkit/policyconfig-1.dtd">
<policyconfig>
  <vendor>Satella</vendor>
  <action id="org.satella.mta.manage-p2p">
    <description>Create or remove the Wi-Fi Direct group used for an MTA transfer</description>
    <message>Authentication is required to manage the Wi-Fi Direct group</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <!-- binds this action id to our helper only -->
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/satella-mta-helper</annotate>
  </action>
</policyconfig>
