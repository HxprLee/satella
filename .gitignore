# Rust build artifacts
/target/
**/*.rs.bk

# Local tooling / editor state
.idea/
.vscode/
*.iml
*.swp
*.swo
*~
.cursor/

# OS noise
.DS_Store
Thumbs.db

# Local environment and secrets
.env
.env.*
!.env.example

# Runtime state (databases, logs, generated certs)
*.db
*.db-journal
*.sqlite
*.sqlite3
*.log
/data/

# Test and coverage output
/coverage/
*.profraw
*.profdata
lcov.info
tarpaulin-report.*

# Cargo tooling caches
.cargo/
/benches/baseline/

# Note: Cargo.lock is intentionally tracked (workspace ships binaries).
# Note: crates/*/vendor/ is intentionally tracked (forked upstream engines).
